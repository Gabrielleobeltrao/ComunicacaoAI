PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comunicacaoai
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Agent replies (RAG)
# ANTHROPIC_API_KEY / OPENAI_API_KEY are only fallbacks — users can set their
# own key per account in Settings, which takes priority when present. Each
# agent picks which provider (Anthropic or OpenAI) it uses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Used to encrypt secrets stored in the database (e.g. user-provided API keys
# and connected-integration tokens). Any long random string works — generate
# one with `openssl rand -hex 32`.
ENCRYPTION_KEY=replace-with-a-long-random-string

# Google Calendar integration (optional). Create OAuth credentials in Google
# Cloud (Web application) and add the redirect URI below to that client. Leave
# blank to hide the integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to BETTER_AUTH_URL + /api/integrations/google/callback if omitted.
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
