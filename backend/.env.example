# Backend environment. Copy to `.env` for local development and fill in.
# For a production template see .env.production.example.
# In production (NODE_ENV=production) the app FAILS FAST at startup if any
# required variable below is missing or malformed — there are no silent
# localhost fallbacks in production. Never commit a real .env.

# --- Runtime -------------------------------------------------------------------
# development | production. Drives fail-fast validation and secure cookies.
NODE_ENV=development
# Internal port the Node process listens on.
PORT=4000

# --- URLs (no trailing slash) --------------------------------------------------
# CLIENT_URL: public origin(s) of the frontend allowed to call the private API
# and Socket.IO with credentials. Comma-separated for multiple origins, e.g.
# "https://comunicacaoai.oneplataforma.com,http://localhost:5173".
CLIENT_URL=http://localhost:5173
# BETTER_AUTH_URL: public origin of THIS backend (auth base + Google callback).
#   production: https://api.comunicacaoai.oneplataforma.com
BETTER_AUTH_URL=http://localhost:4000
# PUBLIC_URL: public origin of THIS backend used to build inbound webhook URLs
# (e.g. the WhatsApp webhook the owner pastes into their provider).
#   production: https://api.comunicacaoai.oneplataforma.com
PUBLIC_URL=http://localhost:4000

# --- Data + secrets (runtime-only; never expose to the browser) ----------------
# REQUIRED IN PRODUCTION: MONGODB_URI, BETTER_AUTH_SECRET, ENCRYPTION_KEY,
# CLIENT_URL, BETTER_AUTH_URL and PUBLIC_URL. MongoDB is the ONLY infrastructure
# this app needs — the automation queue and scheduler live in it too.
# MONGODB_URI: connection string. The database name comes from the URI path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comunicacaoai
# BETTER_AUTH_SECRET: signs session cookies. Long random string, unique per env.
#   generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# ENCRYPTION_KEY: encrypts secrets stored in the database (user-provided API keys
# and connected-integration tokens, including per-channel WhatsApp/Meta/Twilio
# credentials). Distinct from BETTER_AUTH_SECRET.
#   generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Agent replies (RAG) — optional --------------------------------------------
# ANTHROPIC_API_KEY / OPENAI_API_KEY are only fallbacks — users can set their
# own key per account in Settings, which takes priority when present. Each
# agent picks which provider (Anthropic or OpenAI) it uses. Leaving these blank
# does NOT block startup; the feature is simply unavailable until a key exists.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_AUX_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_AUX_MODEL=
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# --- Google Calendar integration (optional) ------------------------------------
# Create OAuth credentials in Google Cloud (Web application) and add the redirect
# URI below to that client. Leave blank to hide the integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to BETTER_AUTH_URL + /api/integrations/google/callback if omitted.
#   production: https://api.comunicacaoai.oneplataforma.com/api/integrations/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# --- AI operational-building pivot flags (default OFF) --------------------------
# Turn features on only once their phase is proven. Set to "true" to enable.
AI_BUILDING_ENABLED=false
AI_FLOORS_ENABLED=false
AI_AUTOMATIONS_ENABLED=false
AI_SCHEDULER_ENABLED=false
AI_DELIVERIES_ENABLED=false
AI_OFFICE_LIVE_STATUS_ENABLED=false

# --- Automation engine (no broker) ---------------------------------------------
# Scheduled routines and queued runs are handled INSIDE the API process by
# polling MongoDB: the automation_runs collection is the queue, and each
# automation carries its own nextRunAt. There is nothing else to install.
#
# EMBEDDED_WORKER=false turns the engine off here so it can run as a dedicated
# process instead (`npm run start:worker`, same image). Only useful at a scale
# this app is not at yet; leaving it unset is the supported setup.
# EMBEDDED_WORKER=true
# How many runs execute at once, and how often the loops look for work.
# WORKER_CONCURRENCY=4
# RUN_POLL_MS=3000
# SCHEDULER_POLL_MS=15000
# How long a claimed run stays claimed before another instance may take it over
# (a crash recovers automatically once this passes), and how many failed claims
# park a run as failed instead of retrying it forever.
# RUN_LEASE_MS=600000
# MAX_RUN_CLAIMS=3
# STEP_TIMEOUT_MS=60000
# MAX_STEPS_PER_RUN=20
#
# How long SIGTERM may take before the process forces itself out. It MUST stay
# below the orchestrator's stop_grace_period (30s in compose and Coolify), so the
# engine finishes draining in-flight runs instead of being SIGKILLed mid-run.
# Raise both together, never just this one. A forced exit is still safe: the runs
# keep their lease, it expires, and another instance reclaims them.
# SHUTDOWN_TIMEOUT_MS=25000
