# Backend environment. Copy to `.env` for local development and fill in.
# For a production template see .env.production.example.
# In production (NODE_ENV=production) the app FAILS FAST at startup if any
# required variable below is missing or malformed — there are no silent
# localhost fallbacks in production. Never commit a real .env.

# --- Runtime -------------------------------------------------------------------
# development | production. Drives fail-fast validation and secure cookies.
NODE_ENV=development
# Internal port the Node process listens on.
PORT=4000

# --- URLs (no trailing slash) --------------------------------------------------
# CLIENT_URL: public origin(s) of the frontend allowed to call the private API
# and Socket.IO with credentials. Comma-separated for multiple origins, e.g.
# "https://comunicacaoai.onplataform.com,http://localhost:5173".
CLIENT_URL=http://localhost:5173
# BETTER_AUTH_URL: public origin of THIS backend (auth base + Google callback).
#   production: https://api.comunicacaoai.onplataform.com
BETTER_AUTH_URL=http://localhost:4000
# PUBLIC_URL: public origin of THIS backend used to build inbound webhook URLs
# (e.g. the WhatsApp webhook the owner pastes into their provider).
#   production: https://api.comunicacaoai.onplataform.com
PUBLIC_URL=http://localhost:4000

# --- Data + secrets (runtime-only; never expose to the browser) ----------------
# REQUIRED IN PRODUCTION: MONGODB_URI, BETTER_AUTH_SECRET, ENCRYPTION_KEY,
# CLIENT_URL, BETTER_AUTH_URL and PUBLIC_URL. MongoDB is the ONLY infrastructure
# this app needs — the automation queue and scheduler live in it too.
# MONGODB_URI: connection string. The database name comes from the URI path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comunicacaoai
# BETTER_AUTH_SECRET: signs session cookies. Long random string, unique per env.
#   generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# ENCRYPTION_KEY: encrypts secrets stored in the database (user-provided API keys
# and connected-integration tokens, including per-channel WhatsApp/Meta/Twilio
# credentials). Distinct from BETTER_AUTH_SECRET.
#   generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Agent replies (RAG) — optional --------------------------------------------
# ANTHROPIC_API_KEY / OPENAI_API_KEY are only fallbacks — users can set their
# own key per account in Settings, which takes priority when present. Each
# agent picks which provider (Anthropic or OpenAI) it uses. Leaving these blank
# does NOT block startup; the feature is simply unavailable until a key exists.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_AUX_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_AUX_MODEL=
VOYAGE_API_KEY=

# --- Embeddings: modelo, franquia e proteção contra cobrança --------------------
# A busca por semelhança usa o Voyage. A conta tem uma franquia gratuita e, quando
# ela acaba, o provedor NÃO para: ele passa a cobrar. As variáveis abaixo existem
# para que isso nunca aconteça sem alguém ter decidido.
#
# Modelos aceitos (a lista é uma política, não um catálogo): voyage-4,
# voyage-4-lite, voyage-4-large, voyage-context-4, voyage-code-4. Um nome fora
# dela é recusado com aviso no log e o padrão assume — um erro de digitação não
# vira uma chamada a um modelo mais caro.
VOYAGE_MODEL=voyage-4

# Recuo quando o PROVEDOR não reconhece o modelo principal. Não serve, e não é
# usado, para contornar limite de tokens: a franquia é a mesma nos dois modelos.
VOYAGE_MODEL_FALLBACK_ENABLED=true
VOYAGE_FALLBACK_MODEL=voyage-4-lite

# O interruptor que decide se este servidor pode gerar fatura. Em `false` (padrão),
# ao chegar no corte o sistema PARA de indexar em vez de começar a cobrar — um
# problema visível e reversível, ao contrário de uma cobrança.
VOYAGE_PAID_USAGE_ENABLED=false
VOYAGE_HARD_LIMIT_ENABLED=true

# A franquia declarada da conta, em tokens, e o ponto onde o sistema para. O corte
# fica ABAIXO da franquia de propósito: a estimativa de tokens erra, e a margem é o
# que impede que o erro vire cobrança. A franquia é da CONTA — trocar de modelo não
# ganha franquia nova, então o contador é um só.
VOYAGE_FREE_TOKEN_LIMIT=200000000
VOYAGE_HARD_STOP_TOKENS=190000000

# Tetos do operador. 0 = sem teto. O de requisição evita que um documento gigante
# vire uma chamada só; os de dia e mês são orçamento, não proteção de franquia.
VOYAGE_MAX_TOKENS_PER_REQUEST=120000
VOYAGE_DAILY_TOKEN_LIMIT=0
VOYAGE_MONTHLY_TOKEN_LIMIT=0

# Repetição diante de 429 e 5xx. Finita por definição: retry sem teto é loop, e um
# loop contra um provedor que pede calma é como um limite temporário vira bloqueio.
VOYAGE_MAX_RETRIES=2
VOYAGE_MAX_BACKOFF_SECONDS=30

# --- Google Calendar integration (optional) ------------------------------------
# Create OAuth credentials in Google Cloud (Web application) and add the redirect
# URI below to that client. Leave blank to hide the integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to BETTER_AUTH_URL + /api/integrations/google/callback if omitted.
#   production: https://api.comunicacaoai.onplataform.com/api/integrations/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# --- AI operational-building pivot flags (default OFF) --------------------------
# Turn features on only once their phase is proven. Set to "true" to enable.
AI_BUILDING_ENABLED=false
AI_FLOORS_ENABLED=false
AI_AUTOMATIONS_ENABLED=false
AI_SCHEDULER_ENABLED=false
AI_DELIVERIES_ENABLED=false
AI_OFFICE_LIVE_STATUS_ENABLED=false

# --- Automation engine (no broker) ---------------------------------------------
# Scheduled routines and queued runs are handled INSIDE the API process by
# polling MongoDB: the automation_runs collection is the queue, and each
# automation carries its own nextRunAt. There is nothing else to install.
#
# EMBEDDED_WORKER=false turns the engine off here so it can run as a dedicated
# process instead (`npm run start:worker`, same image). Only useful at a scale
# this app is not at yet; leaving it unset is the supported setup.
# EMBEDDED_WORKER=true
# How many runs execute at once, and how often the loops look for work.
# WORKER_CONCURRENCY=4
# RUN_POLL_MS=3000
# SCHEDULER_POLL_MS=15000
# How long a claimed run stays claimed before another instance may take it over
# (a crash recovers automatically once this passes), and how many failed claims
# park a run as failed instead of retrying it forever.
# RUN_LEASE_MS=600000
# MAX_RUN_CLAIMS=3
# STEP_TIMEOUT_MS=60000
# MAX_STEPS_PER_RUN=20
#
# How long SIGTERM may take before the process forces itself out. It MUST stay
# below the orchestrator's stop_grace_period (30s in compose and Coolify), so the
# engine finishes draining in-flight runs instead of being SIGKILLed mid-run.
# Raise both together, never just this one. A forced exit is still safe: the runs
# keep their lease, it expires, and another instance reclaims them.
# SHUTDOWN_TIMEOUT_MS=25000

# --- Logs e auditoria -----------------------------------------------------------
# Two timelines, no new engine: executions are READ from automation_runs/step_runs
# (never copied), and every change to the account is appended to `audit_events`.
#
# RETENTION: audit events are append-only and are kept INDEFINITELY. There is no TTL
# index and nothing in the application deletes them — an operator who needs a
# retention window applies it explicitly against the database, so a log can never
# quietly lose the period someone is about to ask about.
#
# PRIVACY: the trail stores who/what/when/result plus an ALLOWLISTED set of small
# operational fields. A request body, a prompt, a webhook payload, a header, a
# cookie, a credential or an output can never enter it — they are not allowlisted,
# so there is nothing to scrub afterwards.

# --- Grounding (RAG) ------------------------------------------------------------
# How much curated knowledge one execution may inject, and how relevant a passage
# must be to count as knowledge at all. A match below the floor is NOT context: it
# would be presented to the model as if it had been curated. Set 0 to keep every
# hit (the behaviour before the floor existed).
# KNOWLEDGE_TOP_K=6
# KNOWLEDGE_CHAR_BUDGET=6000
# KNOWLEDGE_MIN_SCORE=0.5

# --- Busca na web (opcional, e só para o tipo Pesquisador) ----------------------
# Diferente das "fontes web" de um agente: aquilo é ler endereços que o dono
# cadastrou; isto é DESCOBRIR endereços que ninguém cadastrou. Sem configuração não
# há busca, e a tela diz isso — em vez de prometer uma função que não acontece.
#
# `brave` é a integração oficial. `http` é o adaptador genérico, para quem já
# aponta para outro serviço.
WEB_SEARCH_PROVIDER=brave

# A credencial do Brave. Configure no Coolify, nunca em arquivo versionado. Ela é
# lida só do ambiente: não vai para o banco, não volta para a tela, não entra em
# log nem em mensagem de erro.
BRAVE_SEARCH_API_KEY=

# A franquia do plano gratuito, contada por MÊS (UTC) e por INSTALAÇÃO — ela
# pertence à chave, não ao usuário nem ao agente. Com uso pago desligado, nenhum
# número acima de 900 é aceito, mesmo que a variável peça mais: quem configura
# 5000 sem ligar o uso pago está pedindo uma conta, não um limite.
BRAVE_MONTHLY_REQUEST_LIMIT=900
BRAVE_PAID_USAGE_ENABLED=false

# O adaptador genérico (WEB_SEARCH_PROVIDER=http). Aponte para o serviço que
# preferir e descreva onde estão os três campos na resposta dele. `{query}` é
# substituído pelo termo; sem ele, `?q=` é acrescentado.
WEB_SEARCH_URL=
WEB_SEARCH_RESULTS_PATH=results
WEB_SEARCH_TITLE_FIELD=title
WEB_SEARCH_URL_FIELD=url
WEB_SEARCH_SNIPPET_FIELD=snippet
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_KEY_HEADER=Authorization
WEB_SEARCH_API_KEY_PREFIX=
WEB_SEARCH_PROVIDER_NAME=
