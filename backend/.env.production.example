# Production template for the backend. Set these as runtime env in Coolify.
# URLs are the definitive ASCII origins (no trailing slash). Secrets below are
# PLACEHOLDERS — generate real ones at deploy time and never commit them.
#
#   frontend public origin: https://comunicacaoai.onplataform.com
#   backend  public origin: https://api.comunicacaoai.onplataform.com

# --- Runtime -------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# --- URLs (no trailing slash) --------------------------------------------------
# Exact frontend origin allowed to call the private API + Socket.IO with cookies.
CLIENT_URL=https://comunicacaoai.onplataform.com
# This backend's public origin (auth base + Google callback derivation).
BETTER_AUTH_URL=https://api.comunicacaoai.onplataform.com
# This backend's public origin used to build inbound webhook URLs (WhatsApp).
PUBLIC_URL=https://api.comunicacaoai.onplataform.com
#
# NOTE: the allowlist is carried by CLIENT_URL (comma-separated if ever needed).
# A separate CLIENT_URLS variable is NOT implemented — do not set it.

# --- Data + secrets (generate real values at deploy; keep OUT of git) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comunicacaoai
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# --- Optional providers (blank = feature disabled, startup still succeeds) ------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# --- Google Calendar (optional). Redirect must be registered in Google Cloud ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to BETTER_AUTH_URL + /api/integrations/google/callback if omitted:
GOOGLE_REDIRECT_URI=https://api.comunicacaoai.onplataform.com/api/integrations/google/callback

# --- Busca na web (opcional, e só para o tipo Pesquisador) ----------------------
# Diferente das "fontes web" de um agente: aquilo é ler endereços que o dono
# cadastrou; isto é DESCOBRIR endereços que ninguém cadastrou. Sem configuração não
# há busca, e a tela diz isso — em vez de prometer uma função que não acontece.
#
# `brave` é a integração oficial. `http` é o adaptador genérico, para quem já
# aponta para outro serviço.
WEB_SEARCH_PROVIDER=brave

# A credencial do Brave. Configure no Coolify, nunca em arquivo versionado. Ela é
# lida só do ambiente: não vai para o banco, não volta para a tela, não entra em
# log nem em mensagem de erro.
BRAVE_SEARCH_API_KEY=

# A franquia do plano gratuito, contada por MÊS (UTC) e por INSTALAÇÃO — ela
# pertence à chave, não ao usuário nem ao agente. Com uso pago desligado, nenhum
# número acima de 900 é aceito, mesmo que a variável peça mais: quem configura
# 5000 sem ligar o uso pago está pedindo uma conta, não um limite.
BRAVE_MONTHLY_REQUEST_LIMIT=900
BRAVE_PAID_USAGE_ENABLED=false
