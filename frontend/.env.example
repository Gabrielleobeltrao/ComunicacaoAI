# Frontend environment (Vite). For a production template see .env.production.example.
#
# IMPORTANT: every VITE_* variable is PUBLIC. Vite inlines it into the browser
# bundle at BUILD time, so it is visible to anyone who loads the app. Never put a
# secret, private key, or token in a VITE_* variable.
#
# VITE_API_URL: full public origin of the backend API, no trailing slash.
#   - local dev:    http://localhost:4000
#   - production:   https://api.comunicacaoai.onplataform.com  (set as a Docker --build-arg)
VITE_API_URL=http://localhost:4000
