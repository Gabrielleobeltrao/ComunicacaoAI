# Production template for the frontend (Vite). Copy to a deploy-time value in
# Coolify. VITE_API_URL is PUBLIC and inlined into the bundle at BUILD time —
# pass it as a Docker --build-arg, not a runtime env. No secrets belong here.
#
# Definitive production origins (ASCII, no trailing slash):
#   frontend: https://comunicacaoai.onplataform.com
#   backend:  https://api.comunicacaoai.onplataform.com

VITE_API_URL=https://api.comunicacaoai.onplataform.com
