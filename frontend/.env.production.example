# Production template for the frontend (Vite). Every VITE_* value here is PUBLIC
# and inlined into the browser bundle at BUILD time — pass them as Docker
# --build-arg (or Coolify BUILD variables), NOT runtime env. Changing a value
# requires a REBUILD of the frontend; a runtime change does not alter an already
# built bundle. No secrets belong here.
#
# Definitive production origins (ASCII, no trailing slash):
#   frontend: https://comunicacaoai.onplataform.com
#   backend:  https://api.comunicacaoai.onplataform.com

# Backend origin the browser calls.
VITE_API_URL=https://api.comunicacaoai.onplataform.com

# AI operational-building feature flags. São TRÊS, e produção liga as três.
#
# VITE_AI_BUILDING_ENABLED é a chave mestra da navegação V2 (Prédio → Andar →
# módulos, seletor de andar no celular). Com ela desligada, o deploy mostra a
# interface antiga mesmo no código mais novo.
#
# Existiram seis. VITE_AI_FLOORS_ENABLED, VITE_AI_SCHEDULER_ENABLED e
# VITE_AI_DELIVERIES_ENABLED foram removidas porque nenhuma linha do código as
# lia — este arquivo chegava a trazer FLOORS=false ao lado de BUILDING=true, o que
# parecia uma contradição e não desligava nada. Se ainda estiverem definidas no
# ambiente, são ignoradas.
VITE_AI_BUILDING_ENABLED=true
VITE_AI_AUTOMATIONS_ENABLED=true
VITE_AI_OFFICE_LIVE_STATUS_ENABLED=true
