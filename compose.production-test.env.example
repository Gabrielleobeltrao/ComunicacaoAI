# Example env for compose.production-test.yml. Copy to compose.production-test.env
# (git-ignored) and fill with TEST values. NEVER put real production secrets here.
#
#   cp compose.production-test.env.example compose.production-test.env

# --- External MongoDB (Atlas or a throwaway test cluster) ----------------------
# Required. The compose refuses to start without it. Use a TEST database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comunicacaoai_test

# --- Secrets (generate throwaway ones for the test) ----------------------------
#   openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-test-random-string
ENCRYPTION_KEY=replace-with-a-test-random-string

# --- Two-origin URLs (defaults match the published container ports) ------------
# Frontend is published on :8080, backend on :4000 — a genuine two-origin setup.
CLIENT_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:4000
PUBLIC_URL=http://localhost:4000
# Public build arg baked into the frontend bundle. Point it at the backend origin.
VITE_API_URL=http://localhost:4000

# --- Host port mapping (change if 4000/8080 are taken) -------------------------
BACKEND_PORT=4000
FRONTEND_PORT=8080

# --- Optional providers (leave blank to run without AI features) ---------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
