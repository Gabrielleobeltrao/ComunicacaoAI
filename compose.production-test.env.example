# Example env for compose.production-test.yml. Copy to compose.production-test.env
# (git-ignored) and fill with TEST values. NEVER put real production secrets here.
#
#   cp compose.production-test.env.example compose.production-test.env

# --- External MongoDB (Atlas or a throwaway test cluster) ----------------------
# Required. The compose refuses to start without it. Use a TEST database.
# Aponte para um banco SEU. No CI este valor é substituído pelo override
# `compose.ci-smoke.yml`, que sobe um Mongo efêmero na própria rede do compose —
# nenhuma credencial real entra neste arquivo.
#
# Para rodar localmente com o mesmo banco efêmero:
#   docker compose -f compose.production-test.yml -f compose.ci-smoke.yml \
#     --env-file compose.production-test.env up --build
MONGODB_URI=mongodb://mongo:27017/comunicacaoai_test?replicaSet=rs0

# --- Secrets (generate throwaway ones for the test) ----------------------------
#   openssl rand -hex 32
# Dois segredos DIFERENTES, longos e aleatórios. Gere cada um com:
#   openssl rand -base64 48
# A validação de produção recusa valor curto, previsível, de exemplo — e recusa os dois
# iguais: com a mesma chave, um vazamento derruba a sessão e o cofre de credenciais junto.
BETTER_AUTH_SECRET=replace-with-a-generated-random-string-1
ENCRYPTION_KEY=replace-with-a-different-generated-random-string-2
# Rotação da chave do cofre: a nova entra em ENCRYPTION_KEY e a anterior fica aqui até
# tudo ser regravado. Aceita mais de uma, separadas por vírgula.
# ENCRYPTION_KEY_PREVIOUS=

# --- Two-origin URLs (defaults match the published container ports) ------------
# Frontend is published on :8080, backend on :4000 — a genuine two-origin setup.
# ORIGENS PÚBLICAS, não alvos de conexão: nada disca para elas. Ficam em https e nos
# domínios reais porque `NODE_ENV=production` exige https — e o objetivo deste teste é
# exercitar a validação de produção inteira, não contorná-la.
CLIENT_URL=https://comunicacaoai.onplataform.com
BETTER_AUTH_URL=https://api.comunicacaoai.onplataform.com
PUBLIC_URL=https://api.comunicacaoai.onplataform.com
# Public build arg baked into the frontend bundle. Point it at the backend origin.
VITE_API_URL=http://localhost:4000

# --- Host port mapping (change if 4000/8080 are taken) -------------------------
BACKEND_PORT=4000
FRONTEND_PORT=8080

# --- Optional providers (leave blank to run without AI features) ---------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
